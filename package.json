{
  "name": "system-atlas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "validate-data": "tsx scripts/validate-data.ts",
    "build:knowledge": "tsx scripts/build-knowledge.ts",
    "build": "npm run validate-data && npm run build:knowledge && tsc -b && vite build",
