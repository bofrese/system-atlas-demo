  {
    "id": "req-daily-report",
    "title": "Every completed transfer appears in the daily report to the regulator",
    "capability": "Regulatory reporting",
    "narrative": "Every completed transfer appears in the daily report to the regulator.",
    "acceptanceCriteria": [
      "A completed transfer appears in the report for its date.",
      "The amount is counted in the total for its currency.",
      "The report row links to the source transfer."
    ],
    "businessRisk": "An incomplete report to the regulator is a compliance breach.",
    "preconditions": [
      "Deployment inventory exists for the environment.",
      "Test accounts only."
    ],
    "ownerTeamId": "team-reporting",
    "sourceReferences": [
      "src-tests",
      "src-curated"
    ],
    "scenarios": [
      {
        "id": "req-daily-report-main",
        "title": "Main path",
        "kind": "main",
        "steps": [
          {
            "title": "Send 250.00 EUR to a Norwegian account",
            "expected": "The transfer is accepted",
            "componentId": "svc-transfer-intake",
            "operation": "POST /transfers",
            "dataIds": [
              "tbl-transfer",
              "tbl-transfer-event"
            ]
          },
          {
            "title": "Check limits and fraud rules",
            "expected": "The transfer is approved",
            "componentId": "svc-transfer-checks",
            "operation": "POST /checks/transfers",
            "dataIds": [
              "tbl-check-result"
            ]
          },
          {
            "title": "Add the fee and convert the currency",
            "expected": "Fee 2.50 EUR and the rate of the day are applied",
            "componentId": "svc-fees-currency",
            "operation": "GET /accounts, /fees, /rates",
            "dataIds": [
              "tbl-account",
              "tbl-fee-rule",
              "tbl-exchange-rate"
            ]
          },
          {
            "title": "Book money out and money in",
            "expected": "Money out equals money in plus the fee",
            "componentId": "svc-account-booking",
            "operation": "POST /bookings",
            "dataIds": [
              "tbl-booking",
              "tbl-booking-line"
            ]
          },
          {
            "title": "Load the Reporting Warehouse",
            "expected": "The transfer is stored in the warehouse",
            "componentId": "job-reporting-loader",
            "operation": "Warehouse load",
            "dataIds": [
              "tbl-fact-transfer",
              "tbl-fact-daily-total"
            ]
          },
          {
            "title": "Check that the daily payments report contains the transfer",
            "expected": "The transfer is counted in the EUR total",
            "componentId": "svc-payments-report",
            "operation": "GET /reports/daily-payments/{date}",
            "dataIds": [
              "tbl-fact-daily-total"
            ]
          }
        ]
      },
      {
        "id": "req-daily-report-alternate",
        "title": "Other amount or time",
        "kind": "alternate",
        "steps": [
          {
            "title": "Run with a different amount or time",
            "expected": "The expected result is recorded",
            "componentId": "svc-notification",
            "operation": "Test step",
            "dataIds": [
              "tbl-exchange-rate"
            ]
          }
        ]
      },
      {
        "id": "req-daily-report-failure",
        "title": "Dependency unavailable",
        "kind": "failure",
        "steps": [
          {
            "title": "Run with an unavailable dependency",
            "expected": "The transfer is rejected with a recorded reason",
            "componentId": "svc-transfer-intake",
            "operation": "Test step",
            "dataIds": [
              "tbl-booking"
            ]
          }
        ]
      }
    ]
